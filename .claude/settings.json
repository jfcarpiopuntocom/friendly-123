{
  "env": {
    "OBSIDIAN_VAULT_PATH": "/home/user/obsidian-vault"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-check-sw.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "fast-jev-output@jev-pruner-jfc": true,
    "obsidian-second-brain@obsidian-second-brain": true,
    "fast-jev-compaction@fast-jev-compaction-jfc": true
  },
  "extraKnownMarketplaces": {
    "jev-pruner-jfc": {
      "source": {
        "source": "directory",
        "path": "/home/user/friendly-123/.claude/marketplaces/jev-pruner-jfc"
      }
    },
    "obsidian-second-brain": {
      "source": {
        "source": "github",
        "repo": "eugeniughelbur/obsidian-second-brain"
      }
    },
    "fast-jev-compaction-jfc": {
      "source": {
        "source": "directory",
        "path": "/home/user/friendly-123/.claude/marketplaces/fast-jev-compaction-jfc"
      }
    }
  }
}
